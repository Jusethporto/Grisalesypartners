---
import { Icon } from "astro-icon/components";
---

<section id="inicio" class="relative overflow-hidden bg-surface pb-16 pt-28 sm:pb-20 sm:pt-32 lg:pb-16 lg:pt-24">
  <div
    class="hero-silhouette pointer-events-none absolute inset-y-0 right-0 -z-20 w-full max-w-3xl bg-petrol/[0.07]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-40 -top-20 h-[32rem] w-[32rem] rounded-full bg-gold/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute left-0 top-1/3 h-64 w-64 -translate-x-1/2 rounded-full bg-petrol/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-content items-center gap-16 px-6 lg:grid-cols-2 lg:gap-12">
    <div class="reveal max-w-xl">
      <h1 class="text-balance font-heading text-4xl font-bold leading-[1.1] text-petrol sm:text-5xl lg:text-[3.4rem]">
        Transformamos <span class="text-gold">utilidades</span> en liquidez.
      </h1>

      <p class="mt-6 max-w-lg font-body text-lg leading-relaxed text-ink-secondary">
        Ayudamos a las empresas a convertir su rentabilidad en crecimiento sostenible mediante
        estrategias financieras inteligentes, optimización del capital de trabajo y gestión
        eficiente de liquidez.
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row">
        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gold px-7 py-3.5 font-heading text-sm font-semibold text-petrol-dark shadow-subtle transition-all hover:scale-[1.02] hover:shadow-gold"
        >
          Agenda una asesoría
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center justify-center rounded-full border border-petrol/15 px-7 py-3.5 font-heading text-sm font-semibold text-petrol transition-colors hover:bg-surface-secondary"
        >
          Conoce nuestros servicios
        </a>
      </div>
    </div>

    <div class="reveal relative mx-auto w-fit" style="transition-delay:120ms">
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-petrol/10 via-transparent to-gold/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <img
        src="/team/consultor-hero.png"
        alt="Consultor principal de Grisales & Partners"
        width="1536"
        height="1024"
        class="aspect-[681/995] h-72 w-auto object-cover object-[54%_50%] sm:h-80 lg:h-[26rem]"
      />

      <div
        class="absolute bottom-2 -left-4 z-10 hidden items-center gap-3 rounded-2xl border border-petrol/10 bg-surface px-5 py-4 shadow-card sm:flex"
      >
        <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
          <Icon name="lucide:award" class="h-5 w-5" />
        </span>
        <div>
          <p class="font-heading text-lg font-bold text-petrol">+12 años</p>
          <p class="font-body text-xs text-ink-secondary">de experiencia en estrategia financiera</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-silhouette {
    mask-image: url("/backgrounds/hero-silhouette.svg");
    mask-repeat: no-repeat;
    mask-position: right center;
    mask-size: cover;
    -webkit-mask-image: url("/backgrounds/hero-silhouette.svg");
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: right center;
    -webkit-mask-size: cover;
  }
</style>
