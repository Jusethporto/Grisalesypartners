---
import { Icon } from "astro-icon/components";

const fields = [
  { id: "name", name: "name", label: "Nombre completo", type: "text", icon: "lucide:user", required: true, placeholder: "María Restrepo" },
  { id: "company", name: "company", label: "Empresa", type: "text", icon: "lucide:building-2", required: true, placeholder: "Nombre de su empresa" },
  { id: "email", name: "email", label: "Correo", type: "email", icon: "lucide:mail", required: true, placeholder: "nombre@empresa.com" },
  { id: "phone", name: "phone", label: "Teléfono", type: "tel", icon: "lucide:phone", required: false, placeholder: "+57 300 000 0000" },
] as const;
---

<section id="contacto" class="relative overflow-hidden bg-surface-secondary py-20 sm:py-24 lg:py-28">
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-gold/10 blur-3xl sm:h-96 sm:w-96"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 -right-16 h-64 w-64 rounded-full bg-petrol/10 blur-3xl sm:h-80 sm:w-80"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-2xl px-6">
    <div class="reveal text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5 font-body text-xs font-semibold uppercase tracking-widest text-petrol"
      >
        <Icon name="lucide:message-circle" class="h-3.5 w-3.5 text-gold" />
        Hablemos
      </span>
      <h2 class="mt-5 text-balance font-heading text-3xl font-bold leading-tight text-petrol sm:text-4xl lg:text-[2.75rem]">
        Inicie su transformación <span class="text-gold">hoy</span>
      </h2>
      <div class="mx-auto mt-5 h-px w-16 bg-gold-light"></div>
      <p class="mx-auto mt-5 max-w-md font-body text-ink-secondary sm:text-lg">
        Complete el formulario y uno de nuestros consultores senior se pondrá en contacto para una
        sesión diagnóstica gratuita.
      </p>
    </div>

    <form
      data-contact-form
      class="reveal mt-10 space-y-5 rounded-2xl border border-petrol/10 bg-surface p-7 shadow-card sm:p-9"
      style="transition-delay:120ms"
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        {
          fields.map((field) => (
            <div>
              <label
                for={field.id}
                class="font-body text-xs font-semibold uppercase tracking-widest text-ink-secondary"
              >
                {field.label}
              </label>
              <div class="group relative mt-2">
                <Icon
                  name={field.icon}
                  class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-secondary/40 transition-colors group-focus-within:text-gold"
                />
                <input
                  id={field.id}
                  name={field.name}
                  type={field.type}
                  required={field.required}
                  placeholder={field.placeholder}
                  class="w-full rounded-xl border border-petrol/15 bg-surface-secondary/50 py-3 pl-11 pr-4 font-body text-sm text-ink outline-none transition-all focus:border-gold focus:bg-surface focus:ring-4 focus:ring-gold/10"
                />
              </div>
            </div>
          ))
        }
      </div>

      <div>
        <label for="message" class="font-body text-xs font-semibold uppercase tracking-widest text-ink-secondary">
          Mensaje
        </label>
        <div class="group relative mt-2">
          <Icon
            name="lucide:message-square"
            class="pointer-events-none absolute left-4 top-4 h-4 w-4 text-ink-secondary/40 transition-colors group-focus-within:text-gold"
          />
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Cuéntenos sobre el reto que quiere resolver"
            class="w-full resize-none rounded-xl border border-petrol/15 bg-surface-secondary/50 py-3 pl-11 pr-4 font-body text-sm text-ink outline-none transition-all focus:border-gold focus:bg-surface focus:ring-4 focus:ring-gold/10"
          ></textarea>
        </div>
      </div>

      <div class="flex flex-col-reverse items-center gap-4 pt-1 sm:flex-row sm:justify-between">
        <p class="flex items-center gap-2 font-body text-xs text-ink-secondary">
          <Icon name="lucide:shield-check" class="h-4 w-4 text-petrol/40" />
          Respuesta en menos de 24 horas
        </p>
        <button
          type="submit"
          class="group inline-flex w-full items-center justify-center gap-2 rounded-lg bg-petrol px-8 py-3.5 font-heading text-sm font-semibold text-white transition-all hover:bg-petrol-dark hover:shadow-gold sm:w-auto"
        >
          Enviar Solicitud
          <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </button>
      </div>
    </form>
  </div>

  <div
    data-contact-modal
    class="contact-modal fixed inset-0 z-[60] flex items-center justify-center bg-petrol-dark/60 p-6 backdrop-blur-sm"
  >
    <div
      data-contact-modal-panel
      class="contact-modal-panel relative w-full max-w-sm rounded-2xl bg-surface p-8 text-center shadow-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="contact-modal-title"
    >
      <button
        type="button"
        data-contact-modal-close
        aria-label="Cerrar"
        class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-ink-secondary transition-colors hover:bg-surface-secondary hover:text-petrol"
      >
        <Icon name="lucide:x" class="h-4 w-4" />
      </button>

      <span
        data-contact-modal-icon="success"
        class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600"
      >
        <Icon name="lucide:circle-check-big" class="h-7 w-7" />
      </span>
      <span
        data-contact-modal-icon="error"
        class="mx-auto hidden h-14 w-14 items-center justify-center rounded-full bg-red-50 text-red-600"
      >
        <Icon name="lucide:circle-x" class="h-7 w-7" />
      </span>

      <h3 id="contact-modal-title" data-contact-modal-title class="mt-5 font-heading text-lg font-bold text-petrol">
      </h3>
      <p data-contact-modal-message class="mt-2 font-body text-sm text-ink-secondary"></p>

      <button
        type="button"
        data-contact-modal-close
        class="mt-7 w-full rounded-lg bg-petrol px-6 py-3 font-heading text-sm font-semibold text-white transition-colors hover:bg-petrol-dark"
      >
        Cerrar
      </button>
    </div>
  </div>
</section>

<style>
  .contact-modal {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .contact-modal[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0s;
  }

  .contact-modal-panel {
    transform: scale(0.94) translateY(10px);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-modal[data-open="true"] .contact-modal-panel {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-modal,
    .contact-modal-panel {
      transition: none !important;
    }
  }
</style>

<script src="../scripts/contact-form.ts"></script>
